{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "jnovel-backend": {
      "root": "jnovel-backend",
      "runtime": "container"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "jnovel-backend",
        "path": "/api/$1"
      }
    }
  ]
}
