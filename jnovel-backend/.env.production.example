# Backend production environment for Render
APP_ENV=production
APP_DEBUG=false
APP_URL=https://jasyree-1.onrender.com
FRONTEND_URL=https://jasyre.com,https://www.jasyre.com

# Railway public TCP connection details.
# Do not use RAILWAY_PRIVATE_DOMAIN from Render.
DB_HOST=your-railway-public-tcp-host
DB_PORT=your-railway-public-tcp-port
DB_NAME=railway
DB_USER=root
DB_PASS=your-rotated-railway-password

JWT_SECRET=generate-a-long-random-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=jnovel-api

MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=your-mail-user
MAIL_PASS=your-mail-password
MAIL_FROM_ADDRESS=noreply@jasyre.com
MAIL_FROM_NAME=Jasyre

GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
